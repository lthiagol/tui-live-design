{
  "name": "tui-live-design",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Live TUI design canvas — browser-rendered mock TUIs with click-as-context feedback for agents",
  "scripts": {
    "dev": "concurrently -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "node esbuild.config.js --watch",
    "build": "node esbuild.config.js",
    "start": "npm run build && tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "ws": "^8.18.0",
    "zod": "^3.25.76"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true
  }
}
